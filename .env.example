# Environment Variables for Passport Automation System

# Flask Settings
SECRET_KEY=passport_automation_secret_key_2026_se_lab
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Database Settings
# DB_TYPE options: 'mysql' (default) or 'sqlite'
DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=passport_db

# File Upload Settings
MAX_CONTENT_LENGTH=5242880 # 5 MB max file size
UPLOAD_FOLDER=uploads/documents
